{
  "id": "1password",
  "name": "1Password",
  "version": "0.1.0",
  "description": "Fill logins from 1Password, unlocked with Touch ID.",
  "author": "Karli Juhkam",
  "background": "background.ts",
  "page": { "script": "page.ts", "sites": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"] },
  "permissions": {
    "pageAdditions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
    "fillForms": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
    "commands": { "op": ["item list", "item get"] },
    "network": []
  }
}
