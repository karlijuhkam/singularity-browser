<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>Singularity</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>dev.roosa.Singularity</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Singularity</string>
	<key>CFBundleDisplayName</key>
	<string>Singularity</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.4.0</string>
	<key>CFBundleVersion</key>
	<string>5</string>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Karli Juhkam</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<!-- Private drag-and-drop type for dragging a tab from the sidebar onto the page (split view). -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>dev.roosa.singularity.tab</string>
			<key>UTTypeDescription</key>
			<string>Singularity tab</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
	</array>
	<!-- Shown by macOS the first time a web page asks for the camera or microphone (video calls). -->
	<key>NSCameraUsageDescription</key>
	<string>A website, or a program in a terminal tab, wants to use the camera.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>A website, or a program in a terminal tab, wants to use the microphone.</string>
	<!-- Programs in terminal tabs act as Singularity towards macOS privacy checks. Without these
	     texts macOS refuses their requests outright instead of asking you. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>A program in a terminal tab wants to control another app.</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>A program in a terminal tab wants to use files on your Desktop.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>A program in a terminal tab wants to use files in your Documents folder.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>A program in a terminal tab, or a download, wants to use your Downloads folder.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>A website or a program in a terminal tab wants to reach devices on your local network.</string>
	<!-- Sparkle (self-updating). SUFeedURL and SUPublicEDKey are not here: release.sh stamps them
	     into release builds only, so every other build has no updater. Automatic checks are on by
	     default, so Sparkle never asks "check automatically?" itself (Settings → General has the
	     switch); it checks hourly, and it never installs without asking. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>3600</integer>
	<key>SUAllowsAutomaticUpdates</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Let web pages load plain http:// sites, like any browser. Applies to WKWebView content only. -->
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
		<!-- Allow talking to 127.0.0.1 (the per-Space artifact server, Phase 3). -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
