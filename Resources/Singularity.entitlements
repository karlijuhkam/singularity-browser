<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Deliberately NOT sandboxed: terminal tabs (Phase 2) spawn login shells that run
	`claude` and other tools, which cannot work inside the App Sandbox.
	Hardened runtime is enabled at signing time (codesign -o runtime) for notarisation.
	-->
	<!-- Under the hardened runtime, camera and microphone are blocked without these. Web pages
	     still have to ask: macOS asks once for the app, WebKit asks for every site. -->
	<!-- Lets programs in terminal tabs (osascript, agents) send Apple Events; macOS still asks
	     you per target app. Terminal and iTerm carry the same entitlement. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
